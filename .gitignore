__pycache__/
*.pyc
*.pyo
*.log
*.duckdb
*.duckdb.wal
directives/done/
directives/failed/
*.bak.*
shared/outputs/
memories/
.env
*.key

# reachability ratchet census -- regenerated on every run, uploaded as a CI artifact
artifacts/reachability_ratchet.json

# app-surface KL -- regenerated every run, uploaded as a CI artifact
artifacts/app_surface_kl.json
graphify-out/app_surface_kl.json

# spine manifest reference -- regenerated every run, uploaded as a CI artifact
artifacts/spine_manifest.json
artifacts/spine_mounts.generated.py

# prod-drift-sentinel candidate-tree gate verdict (tools/verify_deploy_candidate.py)
artifacts/deploy_candidate_verdict.json

# Queue census history. Written hourly by tools/queue_census_task.ps1 on the tower.
# NOT committed: the derivative alarms need a per-host time series, and an hourly
# JSON in git would be 8,760 commits a year of pure noise. The tower is the
# designated host; tools/queue_census.py --json is how another host asks it.
artifacts/queue_census/

# Lane halt sentinels + the shadow ledger. Per-HOST runtime state, like the queue
# census history: a halt is a fact about this tower right now, not about the tree.
# Committing them would let a halt raised on one box block a lane on another.
artifacts/lane_halts/

# app E2E cutover snapshots -- generated by tests/integration/test_app_e2e.py each run,
# uploaded as CI artifacts. A COMMITTED copy poisons the parity gate: the pg job's
# upload glob ships it and the parity step's 'ls | head -n1' picks it alphabetically
# over the real snapshot (FU-354: 4 red nights from one 322-byte stub via #4123).
artifacts/app_e2e_snapshot_*.json
