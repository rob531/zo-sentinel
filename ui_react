import { useState } from 'react'
import AppShell from './components/AppShell'
import Dashboard from './pages/Dashboard'
import Servers from './pages/Servers'
import ServerDetail from './pages/ServerDetail'
import Submissions from './pages/Submissions'
import Health from './pages/Health'

type Page = 'dashboard' | 'servers' | 'server-detail' | 'submissions' | 'health'

export default function App() {
  const [currentPage, setCurrentPage] = useState<Page>('dashboard')
  const [selectedServerId, setSelectedServerId] = useState<string | null>(null)

  const handleServerSelect = (serverId: string) => {
    setSelectedServerId(serverId)
    setCurrentPage('server-detail')
  }

  const renderPage = () => {
    switch (currentPage) {
      case 'dashboard':
        return <Dashboard onServerSelect={handleServerSelect} />
      case 'servers':
        return <Servers onServerSelect={handleServerSelect} />
      case 'server-detail':
        return selectedServerId ? (
          <ServerDetail serverId={selectedServerId} onBack={() => setCurrentPage('servers')} />
        ) : (
          <div className="text-slate-400">No server selected</div>
        )
      case 'submissions':
        return <Submissions />
      case 'health':
        return <Health />
      default:
        return <Dashboard onServerSelect={handleServerSelect} />
    }
  }

  return (
    <AppShell currentPage={currentPage} onNavigate={setCurrentPage}>
      {renderPage()}
    </AppShell>
  )
}
