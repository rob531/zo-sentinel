import { useState, useMemo } from 'react'
import { ChevronUp, ChevronDown, ChevronLeft, ChevronRight, Search } from 'lucide-react'
import TrustScoreGauge from './TrustScoreGauge'
import VerdictBadge from './VerdictBadge'

interface Server {
  server_id: string
  name: string
  description: string
  trust_score: number
  verdict: 'trusted' | 'amber' | 'untrusted' | 'unknown'
  scan_count: number
  registry_source: string
}

interface ServerDataGridProps {
  servers: Server[]
  onServerSelect: (serverId: string) => void
  isLoading?: boolean
}

type SortKey = 'name' | 'trust_score' | 'scan_count'
type SortDir = 'asc' | 'desc'

export default function ServerDataGrid({ servers, onServerSelect, isLoading }: ServerDataGridProps) {
  const [sortKey, setSortKey] = useState<SortKey>('trust_score')
  const [sortDir, setSortDir] = useState<SortDir>('desc')
  const [page, setPage] = useState(0)
  const [filter, setFilter] = useState('')
  const pageSize = 10

  const filteredServers = useMemo(() => {
    return servers.filter(s => 
      s.name.toLowerCase().includes(filter.toLowerCase()) ||
      s.description.toLowerCase().includes(filter.toLowerCase())
    )
  }, [servers, filter])

  const sortedServers = useMemo(() => {
    return [...filteredServers].sort((a, b) => {
      const aVal = a[sortKey]
      const bVal = b[sortKey]
      if (typeof aVal === 'string') {
        return sortDir === 'asc' 
          ? aVal.localeCompare(bVal as string)
          : (bVal as string).localeCompare(aVal)
      }
      return sortDir === 'asc' ? aVal - bVal : bVal - aVal
    })
  }, [filteredServers, sortKey, sortDir])

  const paginatedServers = useMemo(() => {
    return sortedServers.slice(page * pageSize, (page + 1) * pageSize)
  }, [sortedServers, page])

  const totalPages = Math.ceil(sortedServers.length / pageSize)

  const handleSort = (key: SortKey) => {
    if (sortKey === key) {
      setSortDir(sortDir === 'asc' ? 'desc' : 'asc')
    } else {
      setSortKey(key)
      setSortDir('desc')
    }
  }

  const SortIcon = ({ col }: { col: SortKey }) => {
    if (sortKey !== col) return null
    return sortDir === 'asc' ? <ChevronUp size={14} /> : <ChevronDown size={14} />
  }

  if (isLoading) {
    return (
      <div className="card">
        <div className="animate-pulse space-y-4">
          <div className="h-10 bg-slate-700 rounded"></div>
          <div className="h-64 bg-slate-700 rounded"></div>
        </div>
      </div>
    )
  }

  return (
    <div className="card">
      <div className="mb-4 flex items-center gap-4">
        <div className="relative flex-1 max-w-xs">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={16} />
          <input
            type="text"
            placeholder="Filter servers..."
            value={filter}
            onChange={(e) => { setFilter(e.target.value); setPage(0) }}
            className="w-full bg-slate-700 border border-slate-600 rounded px-3 pl-9 py-1.5 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>
        <span className="text-sm text-slate-400">{sortedServers.length} servers</span>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-sm">
          <thead>
            <tr className="border-b border-slate-700 text-left text-slate-400">
              <th className="pb-3 pr-4 font-medium">
                <button onClick={() => handleSort('name')} className="flex items-center gap-1 hover:text-slate-200">
                  Server <SortIcon col="name" />
                </button>
              </th>
              <th className="pb-3 pr-4 font-medium">Verdict</th>
              <th className="pb-3 pr-4 font-medium">
                <button onClick={() => handleSort('trust_score')} className="flex items-center gap-1 hover:text-slate-200">
                  Trust Score <SortIcon col="trust_score" />
                </button>
              </th>
              <th className="pb-3 pr-4 font-medium">
                <button onClick={() => handleSort('scan_count')} className="flex items-center gap-1 hover:text-slate-200">
                  Scans <SortIcon col="scan_count" />
                </button>
              </th>
              <th className="pb-3 font-medium">Source</th>
            </tr>
          </thead>
          <tbody>
            {paginatedServers.map((server) => (
              <tr 
                key={server.server_id}
                onClick={() => onServerSelect(server.server_id)}
                className="border-b border-slate-700/50 hover:bg-slate-700/30 cursor-pointer transition-colors"
              >
                <td className="py-3 pr-4">
                  <div>
                    <div className="font-medium text-slate-100">{server.name}</div>
                    <div className="text-xs text-slate-400 truncate max-w-xs">{server.description}</div>
                  </div>
                </td>
                <td className="py-3 pr-4">
                  <VerdictBadge verdict={server.verdict as any} />
                </td>
                <td className="py-3 pr-4">
                  <TrustScoreGauge score={server.trust_score} size={48} />
                </td>
                <td className="py-3 pr-4 text-slate-300">{server.scan_count}</td>
                <td className="py-3 text-slate-400">{server.registry_source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div className="mt-4 flex items-center justify-between text-sm text-slate-400">
        <span>Page {page + 1} of {totalPages || 1}</span>
        <div className="flex gap-1">
          <button
            onClick={() => setPage(Math.max(0, page - 1))}
            disabled={page === 0}
            className="p-1.5 rounded hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <ChevronLeft size={16} />
          </button>
          <button
            onClick={() => setPage(Math.min(totalPages - 1, page + 1))}
            disabled={page >= totalPages - 1}
            className="p-1.5 rounded hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <ChevronRight size={16} />
          </button>
        </div>
      </div>
    </div>
  )
}
EOF

