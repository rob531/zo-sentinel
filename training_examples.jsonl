# zo-sentinel-coder training examples
# Format: JSONL - one example per line
# Each example is a prompt/response pair showing correct behaviour
# These can be used for future LoRA fine-tuning if compute becomes available
# For now they serve as few-shot examples in the Modelfile or as training data

{"prompt": "Write a function that writes a record to the mcp_server_registry table.", "response": "def write_registry_record(server_id: str, name: str, verdict: str) -> bool:\n    \"\"\"Write a server record to mcp_server_registry via write_service.\"\"\"\n    try:\n        r = requests.post('http://127.0.0.1:8772/write',\n            json={'table': 'mcp_server_registry',\n                  'rows': {'server_id': server_id, 'name': name, 'verdict': verdict,\n                           'last_seen': datetime.now(timezone.utc).isoformat()},\n                  'wait': True})\n        return r.status_code == 200\n    except Exception as e:\n        log.error(f'write_registry_record: {e}')\n        return False"}

{"prompt": "Write a function that queries unscored servers from mcp_server_registry.", "response": "def get_unscored_servers(limit: int = 20) -> list:\n    \"\"\"Fetch servers that have not yet been scored.\"\"\"\n    try:\n        r = requests.post('http://127.0.0.1:8772/query',\n            json={'sql': f'SELECT server_id, name, url, description FROM mcp_server_registry WHERE trust_score IS NULL LIMIT {limit}'})\n        if r.status_code == 200:\n            return r.json().get('rows', [])\n    except Exception as e:\n        log.error(f'get_unscored_servers: {e}')\n    return []"}

{"prompt": "Write the main daemon loop for a signal analyser service.", "response": "def run():\n    \"\"\"Main daemon loop for signal analyser.\"\"\"\n    logging.basicConfig(\n        level=logging.INFO,\n        filename='/home/workspace/logs/signal_analyser.log',\n        format='%(asctime)s [signal_analyser] %(levelname)s: %(message)s'\n    )\n    log.info('Signal Analyser starting')\n    while True:\n        try:\n            heartbeat()\n            count = run_cycle()\n            log.info(f'Cycle complete: {count} servers scored')\n        except Exception as e:\n            log.error(f'Cycle error: {e}')\n        time.sleep(POLL_SECONDS)\n\nif __name__ == '__main__':\n    run()"}

{"prompt": "Write a heartbeat function for a ZO-SENTINEL service called signal_analyser.", "response": "def heartbeat() -> None:\n    \"\"\"Write service heartbeat to service_health table.\"\"\"\n    try:\n        requests.post('http://127.0.0.1:8772/write',\n            json={'table': 'service_health',\n                  'rows': {'service': 'signal_analyser',\n                           'last_heartbeat': datetime.now(timezone.utc).isoformat()},\n                  'wait': True})\n    except Exception as e:\n        log.warning(f'heartbeat: {e}')"}

{"prompt": "Write a function to create a DuckDB table for mcp_signal_scores.", "response": "def create_signal_scores_table() -> bool:\n    \"\"\"Create mcp_signal_scores table via write_service execute endpoint.\"\"\"\n    sql = '''\n    CREATE TABLE IF NOT EXISTS mcp_signal_scores (\n        id          BIGINT PRIMARY KEY,\n        server_id   VARCHAR NOT NULL,\n        signal_name VARCHAR NOT NULL,\n        score       REAL,\n        evidence    TEXT,\n        scored_at   TIMESTAMPTZ DEFAULT now()\n    )\n    '''\n    try:\n        r = requests.post('http://127.0.0.1:8772/execute',\n            json={'sql': sql.strip(), 'wait': True})\n        return r.status_code == 200\n    except Exception as e:\n        log.error(f'create_signal_scores_table: {e}')\n        return False"}

