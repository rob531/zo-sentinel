# Zo-Sentinel app-data Postgres. SAME schema (alembic migrations) on tower + Fly; only the DSN changes.
POSTGRES_USER=zo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zo_sentinel
POSTGRES_PORT=5432
# The app + the migrations read DATABASE_URL (app/db.py normalizes postgres:// and selects psycopg).
DATABASE_URL=postgresql://zo:change-me@localhost:5432/zo_sentinel
# --- Fly.io (mod later): drop docker-compose / skip the tower install and set DATABASE_URL to the
#     Fly Managed Postgres DSN, then `alembic upgrade head`. e.g.
# DATABASE_URL=postgres://<user>:<pw>@<app>-db.flycast:5432/zo_sentinel