import { useState } from 'react'
import { ChevronDown, ChevronUp } from 'lucide-react'

interface Signal {
  signal_name: string
  score: number
  evidence: string
  scored_at: string
}

interface SignalBreakdownProps {
  signals: Signal[]
  isLoading?: boolean
}

export default function SignalBreakdown({ signals, isLoading }: SignalBreakdownProps) {
  const [expanded, setExpanded] = useState(false)
  const [showAll, setShowAll] = useState(false)

  if (isLoading) {
    return (
      <div className="card">
        <div className="animate-pulse space-y-2">
          <div className="h-4 bg-slate-700 rounded w-3/4"></div>
          <div className="h-4 bg-slate-700 rounded w-1/2"></div>
        </div>
      </div>
    )
  }

  const displaySignals = showAll ? signals : signals.slice(0, 5)

  return (
    <div className="card">
      <button
        onClick={() => setExpanded(!expanded)}
        className="w-full flex items-center justify-between text-slate-200 hover:text-slate-100"
      >
        <h3 className="font-semibold">Signal Breakdown</h3>
        {expanded ? <ChevronUp size={18} /> : <ChevronDown size={18} />}
      </button>

      {expanded && (
        <div className="mt-4 space-y-3">
          {displaySignals.length === 0 ? (
            <p className="text-slate-400 text-sm">No signals available</p>
          ) : (
            displaySignals.map((signal, idx) => (
              <div key={idx} className="bg-slate-700/50 rounded p-3">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-sm font-medium text-slate-200">{signal.signal_name}</span>
                  <span 
                    className={`text-sm font-bold ${
                      signal.score >= 70 ? 'text-emerald-400' :
                      signal.score >= 40 ? 'text-amber-400' : 'text-red-400'
                    }`}
                  >
                    {signal.score}
                  </span>
                </div>
                <p className="text-xs text-slate-400 line-clamp-2">{signal.evidence}</p>
                <p className="text-xs text-slate-500 mt-1">{signal.scored_at}</p>
              </div>
            ))
          )}
          {signals.length > 5 && (
            <button
              onClick={() => setShowAll(!showAll)}
              className="text-sm text-emerald-400 hover:text-emerald-300"
            >
              {showAll ? 'Show less' : `Show all ${signals.length} signals`}
            </button>
          )}
        </div>
      )}
    </div>
  )
}
